# User service: sync every connected source (bank + Swile), each recorded as a sync_runs
# row. Driven by budget-sync.timer.
# Edit ExecStart if your virtualenv lives elsewhere than ~/budget-forecaster-venv.
# Reads service.env (shared with budget-web.service) for BUDGET_CONFIG and, so Swile can
# be synced too, BUDGET_WEB_SECRET_KEY (the key that decrypts the stored Swile token).
[Unit]
Description=Budget Forecaster bank sync

[Service]
Type=oneshot
EnvironmentFile=%h/.config/budget-forecaster/service.env
ExecStart=%h/budget-forecaster-venv/bin/python -m budget_forecaster.main -c ${BUDGET_CONFIG} sync
